---
import Logo from './Logo.astro';
import { getLangFromUrl, useTranslations, homePath, termsPath } from '../i18n/utils';

interface Props {
  /** rota equivalente no outro idioma */
  altPt?: string;
  altEn?: string;
}
const { altPt = '/', altEn = '/en/' } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = homePath(lang);
const terms = termsPath(lang);
const other = lang === 'pt' ? { href: altEn, label: 'EN' } : { href: altPt, label: 'PT' };
---

<header class="nav-wrap">
  <nav class="container nav">
    <a href={home} aria-label={t('nav.home')}>
      <Logo />
    </a>
    <div class="nav-links">
      <a href={`${home}#plataforma`}>{t('nav.platform')}</a>
      <a href={`${home}#recursos`}>{t('nav.features')}</a>
      <a href={`${home}#governanca`}>{t('nav.governance')}</a>
      <a href={`${home}#resultados`}>{t('nav.results')}</a>
      <a href={terms}>{t('footer.col3.d')}</a>
    </div>
    <div class="nav-actions">
      <a class="lang-switch" href={other.href} hreflang={lang === 'pt' ? 'en' : 'pt-BR'} aria-label={lang === 'pt' ? 'Switch to English' : 'Mudar para português'}>
        <span class="lang-current">{lang === 'pt' ? 'PT' : 'EN'}</span>
        <span class="lang-sep">/</span>
        <span class="lang-other">{other.label}</span>
      </a>
      <a class="nav-login" href="https://verticosys.com/login">{t('nav.login')}</a>
      <a class="btn btn-pill-dark" href={`${home}#cta`}>{t('nav.cta')}</a>
    </div>
  </nav>
</header>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;
  }
  .nav-wrap.scrolled {
    border-bottom-color: var(--border-hairline);
  }
  :global(.nav-wrap.nav-hidden) {
    transform: translateY(-100%);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 24px;
  }
  .nav-links {
    display: flex;
    gap: 4px;
  }
  .nav-links a {
    font-size: 13px;
    color: var(--text-secondary);
    padding: 8px 12px;
    border-radius: var(--radius-btn);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-links a:hover {
    color: var(--text-primary);
    background: var(--surface-2);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    letter-spacing: 0.02em;
    padding: 5px 10px;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-pill);
    transition: border-color 0.15s ease;
  }
  .lang-switch:hover {
    border-color: var(--brand-tint-2);
  }
  .lang-current {
    color: var(--brand);
  }
  .lang-sep {
    color: var(--text-faint);
  }
  .lang-other {
    color: var(--text-muted);
  }
  .lang-switch:hover .lang-other {
    color: var(--text-primary);
  }
  .nav-login {
    font-size: 13px;
    color: var(--text-secondary);
  }
  .nav-login:hover {
    color: var(--text-primary);
  }
  @media (max-width: 900px) {
    .nav-links, .nav-login {
      display: none;
    }
  }
</style>
