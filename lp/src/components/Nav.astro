---
import Logo from './Logo.astro';
---

<header class="nav-wrap">
  <nav class="container nav">
    <a href="#" aria-label="VerticoSys — início">
      <Logo />
    </a>
    <div class="nav-links">
      <a href="#plataforma">Plataforma</a>
      <a href="#recursos">Recursos</a>
      <a href="#governanca">Governança</a>
      <a href="#resultados">Resultados</a>
    </div>
    <div class="nav-actions">
      <a class="nav-login" href="https://verticosys.com/login">Entrar</a>
      <a class="btn btn-pill-dark" href="#cta">Agendar demonstração</a>
    </div>
  </nav>
</header>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;
  }
  .nav-wrap.scrolled {
    border-bottom-color: var(--border-hairline);
  }
  :global(.nav-wrap.nav-hidden) {
    transform: translateY(-100%);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 24px;
  }
  .nav-links {
    display: flex;
    gap: 4px;
  }
  .nav-links a {
    font-size: 13px;
    color: var(--text-secondary);
    padding: 8px 12px;
    border-radius: var(--radius-btn);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-links a:hover {
    color: var(--text-primary);
    background: var(--surface-2);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .nav-login {
    font-size: 13px;
    color: var(--text-secondary);
  }
  .nav-login:hover {
    color: var(--text-primary);
  }
  @media (max-width: 820px) {
    .nav-links, .nav-login {
      display: none;
    }
  }
</style>
