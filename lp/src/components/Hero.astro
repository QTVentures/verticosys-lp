---
import DashboardMockup from './DashboardMockup.astro';
import HeroGrid from './HeroGrid.astro';
---

<section class="hero" id="plataforma">
  <HeroGrid />
  <div class="container">
    <div class="hero-copy">
      <h1>
        <span class="enter line" style="--d: 0.08s">Controle financeiro</span>
        <span class="enter line" style="--d: 0.18s">sem pontos cegos.</span>
      </h1>
      <p class="hero-sub enter" style="--d: 0.34s">
        Visibilidade, governança e inteligência para operações que exigem precisão.
        A VerticoSys centraliza processos, aprovações, cobranças e indicadores
        em um único ambiente.
      </p>
      <div class="hero-actions enter" style="--d: 0.5s">
        <a class="btn btn-primary" href="#cta">Agendar demonstração</a>
        <a class="link-arrow" href="#recursos">Conhecer a plataforma <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="hero-mock enter-mock" style="--d: 0.62s">
      <div class="hero-mock-inner">
        <DashboardMockup />
      </div>
    </div>
  </div>
  <div class="hero-floor" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    padding: 110px 0 0;
    overflow: hidden;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
  }
  h1 {
    display: flex;
    flex-direction: column;
  }
  h1 .line {
    display: block;
  }
  .hero-sub {
    font-size: var(--text-body-lg);
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 540px;
    font-weight: 300;
    margin-top: var(--space-32);
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: var(--space-40);
  }
  .hero-mock {
    margin-top: var(--space-80);
    position: relative;
    z-index: 1;
    /* a base sai do hero e é recortada pelo overflow da seção,
       preservando topo, laterais e sombra (profundidade) */
    margin-bottom: -150px;
  }
  .hero-mock :global(.mock) {
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card), var(--shadow-xl);
  }
  .hero-floor {
    position: absolute;
    inset: auto 0 0 0;
    height: 380px;
    background: linear-gradient(180deg, rgba(112, 108, 176, 0) 0%, rgba(112, 108, 176, 0.09) 100%);
    z-index: 0;
    pointer-events: none;
  }
  @media (max-width: 860px) {
    .hero { padding-top: 64px; }
    .hero-actions { flex-wrap: wrap; }
    .hero-mock { margin-top: var(--space-48); margin-bottom: -120px; }
  }
</style>
