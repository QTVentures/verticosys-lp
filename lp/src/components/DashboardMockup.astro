---
// Mockup de produto — dashboard financeiro simulado em HTML/CSS,
// no estilo "product-screenshot-first" da Linear.
---

<div class="mock" role="img" aria-label="Interface da plataforma VerticoSys: painel financeiro com indicadores, fluxo de aprovações e fluxo de caixa">
  <div class="mock-chrome" aria-hidden="true">
    <span class="dot"></span><span class="dot"></span><span class="dot"></span>
    <span class="mock-url">app.verticosys.com</span>
  </div>
  <div class="mock-body" aria-hidden="true">
    <aside class="mock-side">
      <div class="side-item active">Visão geral</div>
      <div class="side-item">Aprovações</div>
      <div class="side-item">Cobranças</div>
      <div class="side-item">Conciliação</div>
      <div class="side-item">Relatórios</div>
      <div class="side-item">Auditoria</div>
    </aside>
    <div class="mock-main">
      <div class="mock-topline">
        <span class="mock-title">Visão geral · Julho 2026</span>
        <span class="mock-badge">Atualizado agora</span>
      </div>
      <div class="kpis">
        <div class="kpi">
          <span class="kpi-label">Saldo consolidado</span>
          <span class="kpi-value">R$ 4.82M</span>
          <span class="kpi-delta up">+3,2% vs. jun</span>
        </div>
        <div class="kpi">
          <span class="kpi-label">A receber (30d)</span>
          <span class="kpi-value">R$ 1.36M</span>
          <span class="kpi-delta up">98,1% conciliado</span>
        </div>
        <div class="kpi">
          <span class="kpi-label">Aprovações pendentes</span>
          <span class="kpi-value">12</span>
          <span class="kpi-delta warn">4 críticas</span>
        </div>
        <div class="kpi">
          <span class="kpi-label">Inadimplência</span>
          <span class="kpi-value">1,8%</span>
          <span class="kpi-delta up">-0,4 p.p.</span>
        </div>
      </div>
      <div class="mock-grid">
        <div class="panel chart-panel">
          <div class="panel-head">
            <span>Fluxo de caixa projetado</span>
            <span class="panel-meta">90 dias</span>
          </div>
          <div class="chart">
            <div class="bar" style="--h: 42%"></div>
            <div class="bar" style="--h: 58%"></div>
            <div class="bar" style="--h: 48%"></div>
            <div class="bar" style="--h: 66%"></div>
            <div class="bar" style="--h: 60%"></div>
            <div class="bar" style="--h: 74%"></div>
            <div class="bar accent" style="--h: 82%"></div>
            <div class="bar" style="--h: 70%"></div>
            <div class="bar" style="--h: 78%"></div>
            <div class="bar" style="--h: 88%"></div>
          </div>
        </div>
        <div class="panel">
          <div class="panel-head">
            <span>Fluxo de aprovações</span>
            <span class="panel-meta">Hoje</span>
          </div>
          <div class="rows">
            <div class="row">
              <span class="row-id">FIN-2041</span>
              <span class="row-text">Pagamento fornecedor — R$ 84.200</span>
              <span class="tag ok">Aprovado</span>
            </div>
            <div class="row">
              <span class="row-id">FIN-2042</span>
              <span class="row-text">Contrato anual — R$ 312.000</span>
              <span class="tag pending">Em análise</span>
            </div>
            <div class="row">
              <span class="row-id">FIN-2043</span>
              <span class="row-text">Reembolso diretoria — R$ 6.180</span>
              <span class="tag ok">Aprovado</span>
            </div>
            <div class="row">
              <span class="row-id">FIN-2044</span>
              <span class="row-text">Renovação SaaS — R$ 48.900</span>
              <span class="tag waiting">Aguardando</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .mock {
    background: var(--surface-0);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card), var(--shadow-xl);
    overflow: hidden;
    font-family: var(--font-body);
    text-align: left;
  }
  .mock-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--border-hairline);
    background: var(--surface-1);
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--surface-3);
  }
  .mock-url {
    margin-left: 12px;
    font-size: 11px;
    color: var(--text-faint);
    background: var(--surface-2);
    border-radius: var(--radius-pill);
    padding: 3px 12px;
  }
  .mock-body {
    display: grid;
    grid-template-columns: 168px 1fr;
  }
  .mock-side {
    border-right: 1px solid var(--border-hairline);
    padding: 14px 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--surface-1);
  }
  .side-item {
    font-size: 12px;
    color: var(--text-muted);
    padding: 6px 10px;
    border-radius: var(--radius-btn);
  }
  .side-item.active {
    background: var(--brand-tint);
    color: var(--brand-deep);
    font-weight: 400;
  }
  .mock-main {
    padding: 16px 20px 20px;
    min-width: 0;
  }
  .mock-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .mock-title {
    font-size: 13px;
    color: var(--text-primary);
    font-weight: 400;
  }
  .mock-badge {
    font-size: 11px;
    color: var(--brand);
    background: var(--brand-tint);
    border-radius: var(--radius-badge);
    padding: 2px 8px;
  }
  .kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 12px;
  }
  .kpi {
    border: 1px solid var(--border-hairline);
    border-radius: 8px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: var(--surface-0);
  }
  .kpi-label {
    font-size: 10.5px;
    color: var(--text-faint);
  }
  .kpi-value {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  .kpi-delta {
    font-size: 10.5px;
  }
  .kpi-delta.up { color: #2e8b57; }
  .kpi-delta.warn { color: #b8860b; }
  .mock-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 10px;
  }
  .panel {
    border: 1px solid var(--border-hairline);
    border-radius: 8px;
    padding: 12px;
    background: var(--surface-0);
  }
  .panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }
  .panel-meta {
    font-size: 10.5px;
    color: var(--text-faint);
  }
  .chart {
    display: flex;
    align-items: flex-end;
    gap: 7px;
    height: 128px;
  }
  .bar {
    flex: 1;
    height: var(--h);
    background: var(--brand-tint-2);
    border-radius: 3px 3px 0 0;
    transform-origin: bottom;
  }
  .bar.accent {
    background: var(--brand);
  }
  @media (prefers-reduced-motion: no-preference) {
    .bar {
      animation: barGrow 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .bar:nth-child(1) { animation-delay: 1.05s; }
    .bar:nth-child(2) { animation-delay: 1.12s; }
    .bar:nth-child(3) { animation-delay: 1.19s; }
    .bar:nth-child(4) { animation-delay: 1.26s; }
    .bar:nth-child(5) { animation-delay: 1.33s; }
    .bar:nth-child(6) { animation-delay: 1.4s; }
    .bar:nth-child(7) { animation-delay: 1.47s; }
    .bar:nth-child(8) { animation-delay: 1.54s; }
    .bar:nth-child(9) { animation-delay: 1.61s; }
    .bar:nth-child(10) { animation-delay: 1.68s; }
    .row {
      opacity: 0;
      animation: rowIn 0.6s ease both;
    }
    .row:nth-child(1) { animation-delay: 1.2s; }
    .row:nth-child(2) { animation-delay: 1.32s; }
    .row:nth-child(3) { animation-delay: 1.44s; }
    .row:nth-child(4) { animation-delay: 1.56s; }
  }
  @keyframes barGrow {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }
  @keyframes rowIn {
    from { opacity: 0; transform: translateX(-8px); }
    to { opacity: 1; transform: translateX(0); }
  }
  .rows {
    display: flex;
    flex-direction: column;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 2px;
    border-top: 1px solid var(--border-hairline);
    min-width: 0;
  }
  .row:first-child { border-top: none; }
  .row-id {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    color: var(--text-faint);
    flex-shrink: 0;
  }
  .row-text {
    font-size: 11.5px;
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
  }
  .tag {
    font-size: 10px;
    border-radius: var(--radius-badge);
    padding: 1px 6px;
    flex-shrink: 0;
  }
  .tag.ok { background: #e6f4ea; color: #2e7d43; }
  .tag.pending { background: var(--brand-tint); color: var(--brand-deep); }
  .tag.waiting { background: var(--surface-2); color: var(--text-muted); }

  @media (max-width: 760px) {
    .mock-side { display: none; }
    .mock-body { grid-template-columns: 1fr; }
    .kpis { grid-template-columns: repeat(2, 1fr); }
    .mock-grid { grid-template-columns: 1fr; }
  }
</style>
