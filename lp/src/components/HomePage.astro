---
// Composição da home — usada pelas rotas / (pt) e /en/
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
// import LogoStrip from '../components/LogoStrip.astro'; // TODO: reativar quando tivermos logos de clientes reais
import Statement from '../components/Statement.astro';
import Figs from '../components/Figs.astro';
import Features from '../components/Features.astro';
import Governance from '../components/Governance.astro';
import Results from '../components/Results.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout altPt="/" altEn="/en/">
  <Nav altPt="/" altEn="/en/" />
  <main>
    <Hero />
    <!-- <LogoStrip /> — prova social desativada até termos clientes reais para exibir -->
    <Statement />
    <Figs />
    <Features />
    <Governance />
    <Results />
    <CTA />
